rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================================
    // 🔹 Helper Functions
    // ==========================================================
    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }
    function isDeveloper() { return role() == "developer"; }
    function isSuperAdmin() { return role() == "super-admin"; }
    function isAdmin() {
      return role() == "admin" || role() == "super-admin";
    }
    function isInCompany(companyId) {
      return request.auth.token.companyId == companyId;
    }
    function isOwnCompany(companyId) {
      return isAdmin() && isInCompany(companyId);
    }
    function isDirectSupervisorOf(userId, companyId) {
      let reportUser = get(/databases/$(database)/documents/users/$(userId));
      return request.auth != null &&
             role() == "supervisor" &&
             isInCompany(companyId) &&
             reportUser.data.companyId == companyId &&
             reportUser.data.reportsTo == request.auth.uid;
    }
    function isPostOwner() {
      return request.auth.uid == resource.data.postUserId;
    }
    function isInSharedWithCompanies() {
      return resource.data.migratedVisibility == "network" &&
             (
               resource.data.sharedWithCompanies == null ||
               request.auth.token.companyId in resource.data.sharedWithCompanies
             );
    }

    function isInviteReadable(inviteId) {
  		let doc = get(/databases/$(database)/documents/pendingInvites/$(inviteId));
  		return doc.data.status == "pending" ||
         doc.data.status == "email-queued";
		}
    // ==========================================================
    // 🔹 Billing Logs (System-Generated)
    // ==========================================================
    match /billingLogs/{logId} {
      allow read: if request.auth != null && hasDeveloperAccess();
      allow write: if false; // system-only writes
      function hasDeveloperAccess() {
        return isDeveloper() || isSuperAdmin();
      }
    }
    // ==========================================================
    // 🔹 Developer Data
    // ==========================================================
    match /developerData/{docId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company == "displaygram.com";
    }
    // ==========================================================
    // 🔹 Pending Users
    // ==========================================================
    match /pendingUsers/{id} {
      allow read, write: if isAdmin(); // Only admins can manage pending users
    }
    // ==========================================================
    // 🔹 Company Invites
    // ==========================================================
    match /companies/{companyId}/invites/{inviteId} {
      allow get: if resource.data.status == "pending";
    }
    // ==========================================================
    // 🔹 Developer/System Notifications (global)
    // ==========================================================
    match /notifications/{notifId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isDeveloper();
    }
    // ==========================================================
    // 🔹 User Notifications
    // ==========================================================
    match /users/{userId}/notifications/{notifId} {
      allow get, list: if request.auth.uid == userId;
      // only Cloud Functions should create these
      allow create: if false;
      // user can mark-as-read
      allow update: if request.auth.uid == userId &&
  			request.resource.data.diff(resource.data).changedKeys().hasOnly(["readBy"]);
      allow delete: if request.auth.uid == userId;
    }

    // ==========================================================
    // 🔹 User Notification Settings
    // ==========================================================
    match /users/{userId}/notificationSettings/{settingsId} {
      // READ: Only the owner can read their settings
      allow get, list: if request.auth.uid == userId;
      // CREATE/UPDATE: owner-only and limited to supported preference fields
      allow create: if request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "likes", "comments", "commentLikes", "goalAssignmentPush",
          "supervisorDisplayAlerts", "developerAnnouncements",
          "emailComments", "emailGoalAssignments", "emailWeeklySummary",
          "quietHours", "createdAt", "updatedAt"
        ]);
      allow update: if request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "likes", "comments", "commentLikes", "goalAssignmentPush",
          "supervisorDisplayAlerts", "developerAnnouncements",
          "emailComments", "emailGoalAssignments", "emailWeeklySummary",
          "quietHours", "updatedAt"
        ]);
      // DELETE: optional, but allow user to remove settings if needed
      allow delete: if request.auth.uid == userId;
    }
    // ==========================================================
    // 🔹 FCM Tokens
    // ==========================================================
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, create, delete: if request.auth.uid == userId;
      allow update: if false;
    }
    // ==========================================================
    // 🔹 Users
    // ==========================================================
    match /users/{userId} {
      // READ: Only themselves
      allow read: if request.auth.uid == userId;
      // UPDATE: Users may only change their own presentation fields. Using
      // changedKeys keeps immutable identity/access fields present in the
      // document without accidentally treating them as edits.
      allow update: if request.auth.uid == userId &&
                    request.resource.data.diff(resource.data).changedKeys().hasOnly([
                      "firstName",
                      "lastName",
                      "phone",
                      "profileUrlOriginal",
                      "profileUrlThumbnail",
                      "updatedAt"
                    ]);
      // UPDATE: Admins can soft-delete users (status only)
      allow update: if isAdmin() &&
                    isOwnCompany(get(/databases/$(database)/documents/users/$(userId)).data.companyId) &&
                    request.resource.data.keys().hasOnly(["status"]) &&
                    request.resource.data.status == "deleted";
      // UPDATE: Developer override
      allow update: if isDeveloper();
      // DELETE: Developer or super-admin of same company
      allow delete: if isDeveloper() ||
                    (isSuperAdmin() &&
                     isOwnCompany(get(/databases/$(database)/documents/users/$(userId)).data.companyId));
    }
    // ==========================================================
    // 🔹 Posts
    // ==========================================================
    match /posts/{postId} {
      allow read: if resource.data.visibility == "public" ||
                   resource.data.migratedVisibility in ["network", "companyOnly"] ||
                   isInCompany(resource.data.companyId) ||
                   isInSharedWithCompanies();
      allow create: if isInCompany(request.resource.data.companyId);
      allow update, delete: if isOwnCompany(resource.data.companyId) || isPostOwner();
    }
    // ==========================================================
    // 🔹 Comments
    // ==========================================================
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth.uid == resource.data.userId ||
                    isOwnCompany(resource.data.companyId);
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(["likes"]);
    }
    // ==========================================================
    // 🔹 Collections
    // ==========================================================
    match /collections/{collectionId} {
  allow get: if resource.data.isShareableOutsideCompany == true;
  allow get, list: if request.auth != null;
  allow create, update, delete: if request.auth != null;
}
    // ==========================================================
    // 🔹 App Config & API Keys
    // ==========================================================
    match /appConfig/{docId} {
      allow read: if true;
    }
    match /apiKeys/{companyId} {
      allow read, write: if false; // Fully blocked to clients
    }
    // ==========================================================
    // 🔹 Companies
    // ==========================================================
    match /companies/{companyId} {
      allow read: if isInCompany(companyId);
    // --- Protect billing & addons ---
    allow update: if isOwnCompany(companyId) &&
      request.resource.data.keys().hasOnly([
        // Allowed fields the client may modify:
        "name",
        "address",
        "status",
        "phone",
        "logoUrl",
        "updatedAt"
      ]);
      // --- Developer or Super Admin override ---
      allow update: if isDeveloper() || isSuperAdmin();
      // --- Block new company creation or deletion by clients ---
      allow create, delete: if false;
      // --- Backend-only override (Cloud Functions) ---
      allow write: if request.auth.token.admin == true; // e.g., service account
    }

    // ==========================================================
		// 🔹 Pricing Plans (public metadata)
		// ==========================================================
		match /plans/{planId} {
  		// READ: Allow all authenticated users to read plan definitions (safe fields only)
  			allow get, list: if request.auth != null;
  		// WRITE: Only developers or service accounts
  			allow write: if isDeveloper();
		}
    // ==========================================================
		// 🔹 Pending Invites (New Company Invites Flow)
		// ==========================================================
		match /pendingInvites/{inviteId} {
  			allow get: if true;
  			allow write: if false;
		}

    match /accessRequests/{id} {
		 allow get, list: if isDeveloper() || isSuperAdmin();
		 allow create, update, delete: if false;
	}

	match /accessRequestRateLimits/{id} {
		allow read, write: if false;
	}

    // ==========================================================
    // 🔹 Activity Events (client writes, CF consumes)
    // ==========================================================
    match /activityEvents/{eventId} {
      // Anyone authenticated can read (harmless)
      allow read: if request.auth != null;
      // Only the actor listed in the event may create the event
      allow create: if request.auth != null &&
                     request.resource.data.actorUserId == request.auth.uid;
      // No client-side update or delete
      allow update, delete: if false;
    }

    // ==========================================================
    // 🔹 Company Goals
    // ==========================================================
    // Distributor-owned execution records. Suppliers receive a sanitized
    // projection through getPartnerGoals and never read these raw documents.
    match /companyGoals/{goalId} {
      allow read: if request.auth != null &&
                  isInCompany(resource.data.companyId);

      allow create: if request.auth != null &&
                    (isAdmin() || isDeveloper()) &&
                    isInCompany(request.resource.data.companyId) &&
                    request.resource.data.createdByUserId == request.auth.uid;

      allow update: if request.auth != null &&
                    isInCompany(resource.data.companyId) &&
                    request.resource.data.companyId == resource.data.companyId &&
                    (
                      isAdmin() ||
                      isDeveloper() ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "submittedPosts"
                      ])
                    );

      allow delete: if request.auth != null &&
                    isInCompany(resource.data.companyId) &&
                    (isAdmin() || isDeveloper());
    }

    // ==========================================================
    // 🔹 Goal Account Reports (rep feedback on goal execution)
    // ==========================================================
    // Contains candid commentary about accounts and possibly named buyers,
    // so it must NOT fall through to the catch-all below — that would expose
    // every company's reports to any authenticated user.
    match /goalAccountReports/{reportId} {
      // Candid account feedback is visible only to its author, that rep's
      // direct supervisor, and company admins/developers.
      allow read: if request.auth != null &&
                  (resource.data.userId == request.auth.uid ||
                   isOwnCompany(resource.data.companyId) ||
                   (isDeveloper() && isInCompany(resource.data.companyId)) ||
                   isDirectSupervisorOf(resource.data.userId, resource.data.companyId));

      // CREATE: only as yourself, only into your own company
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    isInCompany(request.resource.data.companyId) &&
                    request.resource.data.id == reportId &&
                    request.resource.data.keys().hasAll([
                      "id", "companyId", "goalKind", "goalId", "userId",
                      "reasonKeys", "createdAt", "updatedAt"
                    ]) &&
                    request.resource.data.keys().hasOnly([
                      "id", "companyId", "goalKind", "goalId", "goalTitle",
                      "accountNumber", "oppId", "accountName", "userId",
                      "userFirstName", "userLastName", "salesRouteNum",
                      "reasonKeys", "helpKeys", "declinedBy", "note",
                      "resolvedAt", "resolvedBy", "resolution", "createdAt",
                      "updatedAt", "serverUpdatedAt"
                    ]) &&
                    request.resource.data.resolvedAt == null &&
                    request.resource.data.resolvedBy == null &&
                    request.resource.data.resolution == null;

      // UPDATE: authors may revise report details, direct supervisors may
      // record only their follow-up decision, and admins may resolve reports.
      allow update: if request.auth != null &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.companyId == resource.data.companyId &&
                    (
                      (
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          "goalTitle", "accountName", "userFirstName", "userLastName",
                          "salesRouteNum", "reasonKeys", "helpKeys", "declinedBy", "note",
                          "resolvedAt", "resolvedBy", "resolution", "updatedAt", "serverUpdatedAt"
                        ]) &&
                        request.resource.data.resolvedAt == null &&
                        request.resource.data.resolvedBy == null &&
                        request.resource.data.resolution == null
                      ) ||
                      (
                        isDirectSupervisorOf(resource.data.userId, resource.data.companyId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          "supervisorConfirmedAt", "supervisorConfirmedBy", "supervisorNote",
                          "resolvedAt", "resolvedBy", "resolution", "adminDigestAt", "serverUpdatedAt"
                        ]) &&
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["supervisorConfirmedBy"]) ||
                          request.resource.data.supervisorConfirmedBy == request.auth.uid
                        ) &&
                        (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["resolvedBy"]) ||
                          request.resource.data.resolvedBy == request.auth.uid
                        ) &&
                        (request.resource.data.resolution == null ||
                         request.resource.data.resolution == "keep_working")
                      ) ||
                      (
                        (isOwnCompany(resource.data.companyId) ||
                         (isDeveloper() && isInCompany(resource.data.companyId))) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          "resolvedAt", "resolvedBy", "resolution", "resolutionNote", "serverUpdatedAt"
                        ])
                      )
                    );

      // Reps can withdraw their own report; admins can remove a report.
      allow delete: if request.auth != null &&
                    (resource.data.userId == request.auth.uid ||
                     isOwnCompany(resource.data.companyId) ||
                     (isDeveloper() && isInCompany(resource.data.companyId)));
    }

    // ==========================================================
    // TEMPORARY CATCH-ALL (allows all authenticated access)
    //
    // Firestore rules are additive: any matching allow wins, so this rule
    // silently defeats the narrower blocks above for every collection it
    // covers. Collections listed in the exclusion below are opted OUT of
    // the catch-all so their own rules are actually enforced:
    //
    // - plans: billing authorization trusts these docs (price, limits,
    //   custom-contract companyId). Clients must never write them; the
    //   explicit /plans rule above (read: authenticated, write: developer)
    //   becomes the real policy. Cloud Functions and seed scripts use the
    //   Admin SDK, which bypasses rules entirely.
    //
    // The full catch-all removal is still planned (see
    // supplier-territory-scaling-design.md, Phase 5 access audit).
    // ==========================================================
    match /{topLevelCollection}/{path=**} {
      allow read, write: if request.auth != null &&
        topLevelCollection != "accessRequests" &&
        topLevelCollection != "accessRequestRateLimits" &&
        topLevelCollection != "pendingInvites" &&
        topLevelCollection != "mail" &&
        topLevelCollection != "plans" &&
        topLevelCollection != "companyGoals" &&
        topLevelCollection != "goalAccountReports";
    }
    }
}
