# Copy this file to .env.staging and fill it with the separate Firebase test
# project's web-app configuration. Never put production values in this file.
VITE_DISPLAYGRAM_ENV=staging
VITE_FIREBASE_API_KEY=replace-with-staging-value
VITE_FIREBASE_AUTH_DOMAIN=replace-with-staging-value
VITE_FIREBASE_PROJECT_ID=replace-with-staging-value
VITE_FIREBASE_STORAGE_BUCKET=replace-with-staging-value
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-value
VITE_FIREBASE_APP_ID=replace-with-staging-value
VITE_FIREBASE_MEASUREMENT_ID=replace-with-staging-value
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
