VITE_DISPLAYGRAM_ENV=production
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Register the web app with Firebase App Check using a score-based
# reCAPTCHA Enterprise key before enabling Cloud Functions enforcement.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local development only. Create an App Check debug token in Firebase and
# keep the real value in front-end/.env (which is gitignored).
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
